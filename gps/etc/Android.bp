// PenguinOS: gps.conf/flp.conf/gnss_antenna_info.conf come from hardware/qcom/gps (Soong generates
// install rules for every module, so two modules can't share an install path). izat.conf has no
// AOSPA counterpart and stays device-specific.

prebuilt_etc {

    name: "izat.conf.miatoll",
    vendor: true,
    src: "izat.conf",
    filename: "izat.conf",
}
